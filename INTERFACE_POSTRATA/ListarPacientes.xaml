<Window x:Class="INTERFACE_POSTRATA.ListarPacientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista de Pacientes" Height="700" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtPesquisa" Width="300" Height="30" />
            <Button x:Name="btnPesquisar" Content="Pesquisar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnPesquisar_Click" />
            <Button x:Name="btnAtualizar" Content="Atualizar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnAtualizar_Click" />
            <Button x:Name="btnVoltar" Content="Voltar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnVoltar_Click" />
        </StackPanel>

        <DataGrid x:Name="dgPacientes" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
    </Grid>

</Window>
