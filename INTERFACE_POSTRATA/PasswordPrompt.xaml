<Window x:Class="INTERFACE_POSTRATA.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha" Height="180" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#F4FDFD">
        <Border Background="White" Margin="10" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Digite a senha:" FontWeight="SemiBold" />
                <PasswordBox x:Name="pwd" Height="32" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="OK" Width="100" Height="32" Background="#00838F" Foreground="White" Click="Ok_Click" />
                    <Button Content="Cancelar" Width="100" Height="32" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
