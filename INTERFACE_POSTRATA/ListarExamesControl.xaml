<UserControl x:Class="INTERFACE_POSTRATA.ListarExamesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtPesquisa" Width="300" Height="30" />
            <Button x:Name="btnPesquisar" Content="Pesquisar (CPF)" Width="140" Height="30" Margin="10,0,0,0" Click="BtnPesquisar_Click" />
            <Button x:Name="btnTodos" Content="Mostrar Todos" Width="120" Height="30" Margin="10,0,0,0" Click="BtnTodos_Click" />
            <Button x:Name="btnEditar" Content="Editar Selecionado" Width="160" Height="30" Margin="10,0,0,0" Click="BtnEditar_Click" Visibility="Collapsed" />
            <Button x:Name="btnVoltar" Content="Fechar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnVoltar_Click" />
        </StackPanel>

        <DataGrid x:Name="dgExames" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Exame" Binding="{Binding id_exame}" Width="100" />
                <DataGridTextColumn Header="CPF Paciente" Binding="{Binding cpf_paciente}" Width="150" />
                <DataGridTextColumn Header="Paciente" Binding="{Binding paciente_nome}" Width="*" />
                <DataGridTextColumn Header="PSA Total" Binding="{Binding psa_total}" Width="120" />
                <DataGridTextColumn Header="PSA Livre" Binding="{Binding psa_livre}" Width="120" />
                <DataGridTextColumn Header="Densidade" Binding="{Binding densidade_psa}" Width="120" />
                <DataGridTextColumn Header="Data" Binding="{Binding data_exame}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
