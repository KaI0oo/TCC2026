<UserControl x:Class="INTERFACE_POSTRATA.ListarAnamnesesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtPesquisa" Width="300" Height="30" />
            <Button x:Name="btnPesquisar" Content="Pesquisar (CPF)" Width="140" Height="30" Margin="10,0,0,0" Click="BtnPesquisar_Click" />
            <Button x:Name="btnTodos" Content="Mostrar Todos" Width="120" Height="30" Margin="10,0,0,0" Click="BtnTodos_Click" />
            <Button x:Name="btnVoltar" Content="Fechar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnVoltar_Click" />
        </StackPanel>

        <DataGrid x:Name="dgAnamneses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_anamnese}" Width="100" />
                <DataGridTextColumn Header="CPF Paciente" Binding="{Binding cpf_paciente}" Width="150" />
                <DataGridTextColumn Header="Possui doença" Binding="{Binding possui_doenca}" Width="120" />
                <DataGridTextColumn Header="Doenças" Binding="{Binding doencas}" Width="*" />
                <DataGridTextColumn Header="Início" Binding="{Binding inicio_tratamento}" Width="120" />
                <DataGridTextColumn Header="Fim" Binding="{Binding fim_tratamento}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
