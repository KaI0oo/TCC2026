<Window x:Class="INTERFACE_POSTRATA.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Sistema Clínica"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="{DynamicResource PoBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TOPO -->
        <Border Grid.Row="0" Background="{DynamicResource PoHeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <!-- MÉDICO -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="txtHeaderName" Text="Dr. João Silva" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtHeaderCRM" Text="CRM 123456" FontSize="15" Foreground="{DynamicResource PoHeaderSubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- TÍTULO -->
                <TextBlock Grid.Column="1" Text="Sistema de Laudos Médicos" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- USUÁRIO -->
                <TextBlock Grid.Column="2" x:Name="txtWelcome" Text="Bem-vindo, Dr. João" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
            </Grid>
        </Border>
        <!-- CONTEÚDO -->
        <Grid Grid.Row="1"
      Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- MENU LATERAL -->

            <Border Grid.Column="0"
            Style="{StaticResource PoSubtleBorder}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <TreeView x:Name="tvMenu" BorderThickness="0"
                      Background="White"
                      FontSize="26">

                        <!-- Início -->
                        <TreeViewItem x:Name="tvInicioGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Início" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem Header="Painel principal" Selected="Inicio_Click" />
                        </TreeViewItem>

                        <!-- CADASTRO -->
                        <TreeViewItem x:Name="tvCadastroGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Cadastro" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem x:Name="tvCadastrarPaciente" Header="Cadastrar Paciente" Selected="CadastrarPaciente_Click"/>
                            <TreeViewItem x:Name="tvCadastrarAnamnese" Header="Cadastrar Anamnese" Selected="CadastrarAnamnese_Click"/>
                            <TreeViewItem x:Name="tvCadastrarExame" Header="Cadastrar Exame" Selected="CadastrarExame_Click"/>
                        </TreeViewItem>

                        <!-- CONSULTAS -->
                        <TreeViewItem x:Name="tvConsultasGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Consulta" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem x:Name="tvBuscarPacienteGroup" Header="Buscar Paciente">
                                <TreeViewItem x:Name="tvBuscarPacienteUm" Header="Buscar um paciente" Selected="BuscarPaciente_Click"/>
                                <TreeViewItem x:Name="tvBuscarPacienteTodos" Header="Buscar todos os pacientes" Selected="BuscarTodosPacientes_Click"/>
                            </TreeViewItem>
                            <TreeViewItem x:Name="tvBuscarExameGroup" Header="Buscar Exame">
                                <TreeViewItem x:Name="tvBuscarExameUm" Header="Buscar um Exame de um paciente" Selected="BuscarExamePaciente_Click"/>
                                <TreeViewItem x:Name="tvBuscarExameTodosPaciente" Header="Buscar todos os exames de um paciente" Selected="BuscarTodosExamesPaciente_Click"/>
                                <TreeViewItem x:Name="tvBuscarExameTodos" Header="Buscar todos os exames" Selected="BuscarTodosExames_Click"/>
                            </TreeViewItem>
                            <TreeViewItem x:Name="tvBuscarLaudoGroup" Header="Buscar Laudo">
                                <TreeViewItem x:Name="tvBuscarLaudoUm" Header="Buscar um Laudo de um paciente" Selected="BuscarLaudoPaciente_Click"/>
                                <TreeViewItem x:Name="tvBuscarLaudoTodosPaciente" Header="Buscar todos os laudos de um paciente" Selected="BuscarTodosLaudosPaciente_Click"/>
                                <TreeViewItem x:Name="tvBuscarLaudoTodos" Header="Buscar todos os laudos" Selected="BuscarTodosLaudos_Click"/>
                            </TreeViewItem>
                        </TreeViewItem>

                        <!-- EDIÇÃO -->
                        <TreeViewItem x:Name="tvEdicaoGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Edição" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem x:Name="tvEditarPaciente" Header="Editar Paciente" Selected="EditarPaciente_Click"/>
                            <TreeViewItem x:Name="tvEditarAnamnese" Header="Editar Anamnese" Selected="EditarAnamnese_Click"/>
                            <TreeViewItem x:Name="tvEditarExame" Header="Editar Exame" Selected="EditarExame_Click"/>
                        </TreeViewItem>

                        <!-- EXCLUSÃO -->
                        <TreeViewItem x:Name="tvExclusaoGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Exclusão" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem Header="Excluir Paciente" Selected="ExcluirPaciente_Click"/>
                            <TreeViewItem Header="Excluir Anamnese" Selected="ExcluirAnamnese_Click"/>
                            <TreeViewItem Header="Excluir Exame" Selected="ExcluirExame_Click"/>
                            <TreeViewItem Header="Excluir Laudo" Selected="ExcluirLaudo_Click"/>
                        </TreeViewItem>

                        <!-- Inteligência Artificial -->
                        <TreeViewItem x:Name="tvIAGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Inteligência Artificial" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem Header="Treinar IA" Selected="TreinarIA_Click"/>
                        </TreeViewItem>

                        <!-- CONTA -->
                        <TreeViewItem x:Name="tvContaGroup" IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock Text="Conta" FontWeight="Bold" />
                            </TreeViewItem.Header>
                            <TreeViewItem Header="Logout" Selected="Logout_Click"/>
                            <TreeViewItem Header="Fechar Programa" Selected="Sair_Click"/>
                        </TreeViewItem>

                    </TreeView>

                </ScrollViewer>

            </Border>

            <!-- PAINEL PRINCIPAL -->

            <Border Grid.Column="1"
            Margin="10,0,0,0"
            Style="{StaticResource PoPanel}">

                <!-- Conteúdo principal substituível -->
                <ContentControl x:Name="MainContent">
                    <Grid>
                        <Label Content="Painel Principal"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#006064"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,25,0,0"/>

                        <StackPanel Margin="30,100,30,30">

                            <TextBlock Text="Bem-vindo ao sistema da clínica."
                               FontSize="20"
                               FontWeight="SemiBold"/>

                            <TextBlock Text="Selecione uma opção no menu ao lado para iniciar."
                               FontSize="20"
                               Foreground="Gray"
                               Margin="0,15,0,0"/>

                        </StackPanel>
                    </Grid>
                </ContentControl>

            </Border>

        </Grid>
    </Grid>
</Window>