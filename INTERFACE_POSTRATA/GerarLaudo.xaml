<Window x:Class="INTERFACE_POSTRATA.GerarLaudo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Laudo Médico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Grid Background="#EDEDED">

        <Border Background="White"
                Margin="30"
                CornerRadius="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="40">

                    <!-- TOPO -->

                    <TextBlock Text="CLÍNICA "
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#00838F"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Sistema de Laudos Médicos"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,25"/>

                    <Separator Margin="0,0,0,25"/>

                    <!-- DADOS DO PACIENTE -->

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Paciente:"
                                       FontWeight="Bold"
                                       FontSize="20"/>

                            <TextBlock x:Name="txtPaciente"
                                       Margin="0,0,0,15"
                                       FontSize="20"/>

                            <TextBlock Text="Idade:"
                                       FontWeight="Bold"
                                       FontSize="20"/>

                            <TextBlock x:Name="txtIdade"
                                       FontSize="20"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Data do Laudo:"
                                       FontWeight="Bold"
                                       FontSize="20"/>

                            <TextBlock x:Name="txtData"
                                       Margin="0,0,0,15"
                                       FontSize="20"/>

                            <TextBlock Text="Médico:"
                                       FontWeight="Bold"
                                       FontSize="20"/>

                            <TextBlock x:Name="txtMedico"
                                       FontSize="20"/>

                        </StackPanel>

                    </Grid>

                    <!-- RESULTADOS -->

                    <TextBlock Text="Resultados"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,10,0,20"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="20"
                            CornerRadius="8">

                        <StackPanel>

                            <TextBlock x:Name="txtPSATotalLaudo"
                                       FontSize="20"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtPSALivreLaudo"
                                       FontSize="20"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtDensidadeLaudo"
                                       FontSize="20"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtRelacaoLT"
                                       FontSize="20"/>

                        </StackPanel>

                    </Border>

                    <!-- INTERPRETAÇÃO -->

                    <TextBlock Text="Interpretação"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,30,0,20"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="20"
                            CornerRadius="8">

                        <TextBlock x:Name="txtInterpretacao"
                                   TextWrapping="Wrap"
                                   FontSize="20"/>

                    </Border>

                    <!-- CLASSIFICAÇÃO -->

                    <TextBlock Text="Classificação de Risco"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,30,0,20"/>

                    <Border Background="#FFEBEE"
                            Padding="20"
                            CornerRadius="8" Height="83">

                        <TextBlock x:Name="txtClassificacao"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#C62828"
                                   HorizontalAlignment="Center"/>

                    </Border>

                    <!-- ASSINATURA -->

                    <StackPanel Margin="0,70,0,0">

                        <Border BorderBrush="Black"
                                BorderThickness="0,0,0,1"
                                Width="300"
                                HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtAssinaturaMedico"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="20"/>

                        <TextBlock x:Name="txtCRM"
                                   HorizontalAlignment="Center"
                                   FontSize="20"/>
                        <Button Content="Voltar ao Menu" Width="180" Height="45" Margin="0,0,20,0" Background="#00BCD4" Foreground="White" FontWeight="Bold" Click="VoltarMenu_Click"/>
                        
                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>