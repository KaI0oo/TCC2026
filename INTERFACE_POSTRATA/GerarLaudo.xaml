<Window x:Class="INTERFACE_POSTRATA.GerarLaudo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Laudo Médico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Grid Background="#EDEDED">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                Margin="30,30,30,10"
                CornerRadius="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">

                    <!-- CABEÇALHO -->
                    <Border Background="{DynamicResource PoAccentBrush}"
                            CornerRadius="8"
                            Padding="20,14"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Sistema de Laudos Médicos"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Laudo de PSA Total e Livre"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,0,0,20"/>

                    <!-- DADOS DO PACIENTE -->
                    <TextBlock Text="Dados do Paciente"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,0,0,10"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="16" CornerRadius="8"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPaciente" FontSize="16" Margin="0,0,16,10" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="CPF:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtCPF" FontSize="16" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Data de nasc.:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDataNascimento" FontSize="16" Margin="0,0,16,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Idade:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtIdade" FontSize="16"/>
                        </Grid>
                    </Border>

                    <!-- DADOS DO MÉDICO -->
                    <TextBlock Text="Dados do Médico"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,0,0,10"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="16" CornerRadius="8"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Médico:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMedico" FontSize="16" Margin="0,0,16,10" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="CRM:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtCRMMedico" FontSize="16" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Data do laudo:" FontWeight="SemiBold" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtData" FontSize="16"/>
                        </Grid>
                    </Border>

                    <!-- RESULTADOS DO EXAME -->
                    <TextBlock Text="Resultados do Exame"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,0,0,10"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="16" CornerRadius="8"
                            Margin="0,0,0,12">

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PSA Total" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Valores de referência são meramente informativos. A interpretação é de responsabilidade do médico."
                                               FontSize="12" Foreground="#78909C" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtValorPSATotal" FontSize="26" FontWeight="Bold" Foreground="#00838F" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="ng/mL" FontSize="14" Foreground="#607D8B" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PSA Livre" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Valores de referência são meramente informativos. A interpretação é de responsabilidade do médico."
                                               FontSize="12" Foreground="#78909C" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtValorPSALivre" FontSize="26" FontWeight="Bold" Foreground="#00838F" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="ng/mL" FontSize="14" Foreground="#607D8B" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Relação PSA Livre / PSA Total" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Cálculo: (PSA Livre / PSA Total) × 100. Informativo; interpretar conforme contexto clínico."
                                               FontSize="12" Foreground="#78909C" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtValorRelacaoLT" FontSize="26" FontWeight="Bold" Foreground="#00838F" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="%" FontSize="14" Foreground="#607D8B" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Densidade PSA" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Parâmetro complementar; interpretar conforme contexto clínico."
                                               FontSize="12" Foreground="#78909C" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="txtValorDensidade" FontSize="26" FontWeight="Bold" Foreground="#00838F" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="ng/mL" FontSize="14" Foreground="#607D8B" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- INTERPRETAÇÃO -->
                    <TextBlock Text="Interpretação"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,0,0,10"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="16" CornerRadius="8"
                            Margin="0,0,0,20">
                        <TextBlock x:Name="txtInterpretacao"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   LineHeight="24"/>
                    </Border>

                    <!-- CLASSIFICAÇÃO (IA) -->
                    <TextBlock Text="Classificação de Risco"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,0,0,10"/>

                    <Border x:Name="borderClassificacao"
                            Background="#FFEBEE"
                            Padding="20"
                            CornerRadius="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Classificação gerada pela análise assistida (IA)"
                                       FontSize="12" Foreground="#78909C"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtClassificacao"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#C62828"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NOTAS (texto fixo, somente leitura) -->
                    <TextBlock Text="Notas"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#00838F"
                               Margin="0,16,0,10"/>

                    <Border BorderBrush="#B0BEC5"
                            BorderThickness="1"
                            Padding="16" CornerRadius="8"
                            Margin="0,0,0,20">
                        <TextBlock x:Name="txtNotas"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"
                                   IsHitTestVisible="False"
                                   Focusable="False"/>
                    </Border>

                    <!-- ASSINATURA -->
                    <StackPanel Margin="0,40,0,20" HorizontalAlignment="Center">
                        <Border BorderBrush="Black"
                                BorderThickness="0,0,0,1"
                                Width="320"
                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAssinaturaMedico"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                        <TextBlock x:Name="txtCRM"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="txtDataExame"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#546E7A"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RODAPÉ DE AÇÕES -->
        <Border Grid.Row="1"
                Background="#EDEDED"
                Padding="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Voltar ao Menu"
                        Style="{StaticResource PoButtonPrimary}"
                        Width="180" Height="45"
                        Click="VoltarMenu_Click"/>
                <Button x:Name="btnGerarPdf"
                        Content="Gerar PDF"
                        Style="{StaticResource PoButtonSecondary}"
                        Width="160" Height="45"
                        Margin="20,0,0,0"
                        Click="GerarPdf_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
