<Window x:Class="INTERFACE_POSTRATA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Login"
        WindowState="Maximized"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Grid Background="#F4FDFD">

        <Viewbox Stretch="Uniform">

            <Border MaxWidth="500"
                MinWidth="350"
                Background="White"
                BorderBrush="#00BCD4"
                BorderThickness="2"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20">

                <StackPanel Margin="30">

                <Label Content="Sistema de Laudos Médicos"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#00838F"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

                <TextBlock Text="Usuário"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtUsuario"
                         Height="35"
                         FontSize="18"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Senha"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="txtSenha"
                             Height="35"
                             FontSize="18"
                             Margin="0,5,0,25"/>

                <Button Content="Entrar"
                        Height="40"
                        FontWeight="Bold"
                        Background="#00BCD4"
                        Foreground="White"
                        Click="Button_Click"
                        Margin="0,0,0,10"/>
                <TextBlock x:Name="lblLoginError" Foreground="Red" FontSize="14" Margin="0,6,0,6" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Button Content="Sair"
                        Height="40"
                        FontWeight="Bold"
                        Background="#E53935"
                        Foreground="White"
                        Click="Sair_Click"/>

            </StackPanel>

            </Border>

        </Viewbox>

    </Grid>

</Window>