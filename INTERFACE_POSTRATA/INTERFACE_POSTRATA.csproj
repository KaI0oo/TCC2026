<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="INTERFACE_POSTRATA\**" />
    <EmbeddedResource Remove="INTERFACE_POSTRATA\**" />
    <None Remove="INTERFACE_POSTRATA\**" />
    <Page Remove="INTERFACE_POSTRATA\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.2" />
  </ItemGroup>

  <!-- AI Executable and Model Configuration -->
  <ItemGroup>
    <Content Include="..\IA\IA.exe">
      <Link>IA\IA.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\IA\IA.pkl">
      <Link>IA\IA.pkl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>


  <!-- appsettings.json não é obrigatório; a classe Conexao faz fallback para valores padrão se não existir -->

</Project>
