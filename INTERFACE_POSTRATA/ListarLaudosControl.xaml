<UserControl x:Class="INTERFACE_POSTRATA.ListarLaudosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtPesquisa" Width="300" Height="30" />
            <Button x:Name="btnPesquisar" Content="Pesquisar (CPF)" Width="140" Height="30" Margin="10,0,0,0" Click="BtnPesquisar_Click" />
            <Button x:Name="btnTodos" Content="Mostrar Todos" Width="120" Height="30" Margin="10,0,0,0" Click="BtnTodos_Click" />
            <Button x:Name="btnVoltar" Content="Fechar" Width="100" Height="30" Margin="10,0,0,0" Click="BtnVoltar_Click" />
        </StackPanel>

        <DataGrid x:Name="dgLaudos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Laudo" Binding="{Binding id_laudo}" Width="100" />
                <DataGridTextColumn Header="ID Exame" Binding="{Binding id_exame}" Width="100" />
                <DataGridTextColumn Header="Paciente" Binding="{Binding paciente_nome}" Width="*" />
                <DataGridTextColumn Header="Classificação" Binding="{Binding classificacao}" Width="150" />
                <DataGridTextColumn Header="Interpretação" Binding="{Binding interpretacao}" Width="*" />
                <DataGridTextColumn Header="Data" Binding="{Binding data_laudo}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
