<Window x:Class="INTERFACE_POSTRATA.CadastroPaciente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro Paciente"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="#F4FDFD">

        <Viewbox Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080"
                  Background="#F4FDFD">

                <!-- TOPO -->

                <Border Background="#00BCD4"
                        Height="70"
                        VerticalAlignment="Top">

                    <Label Content="Cadastro de Paciente"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Border>

                <!-- FORM -->

                <Border Background="White"
                        Margin="30,100,30,30"
                        CornerRadius="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30"
                                    
                                    >


                            <TextBlock Text="CPF"
                                       FontSize="20"
                                       />
                            
                            <TextBox x:Name="txtCPF"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Nome"
                                       FontSize="20"
                                       />
                            <TextBox x:Name="txtNome"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Data de Nascimento"
                                       FontSize="20"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <TextBox x:Name="txtNascimento" Height="35" Width="200" FontSize="18" MaxLength="10" PreviewTextInput="TxtNascimento_PreviewTextInput" TextChanged="TxtNascimento_TextChanged"/>
                                <TextBlock Text=" " Width="10"/>
                                <TextBlock Text="Idade" VerticalAlignment="Center" FontSize="20" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIdade" Height="35" Width="100" FontSize="18" IsReadOnly="True" Background="#EEE"/>
                            </StackPanel>

                            <TextBlock Text="Sexo"
                                       FontSize="20"/>
                            <ComboBox x:Name="cbSexo"
                                      Height="35"
                                      FontSize="18"
                                      Margin="0,5,0,15">

                                <ComboBoxItem Content="M"
                                              FontSize="18"/>
                                <ComboBoxItem Content="F"
                                              FontSize="18"/>

                            </ComboBox>

                            <TextBlock Text="Tipo Sanguíneo"
                                       FontSize="20"/>
                            <ComboBox x:Name="cbSangue"
                                      Height="35"
                                      FontSize="18"
                                      Margin="0,5,0,15">

                                <ComboBoxItem Content="A+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="A-"
                                              FontSize="18"/>
                                <ComboBoxItem Content="B+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="B-"
                                              FontSize="18"/>
                                <ComboBoxItem Content="AB+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="AB-"/>
                                <ComboBoxItem Content="O+"/>
                                <ComboBoxItem Content="O-"/>

                                <ComboBoxItem Content="O-"/>

                            </ComboBox>

                            <TextBlock Text="Raça"
                                       FontSize="20"/>
                            <ComboBox x:Name="cbRaca"
                                      Height="35"
                                      FontSize="18"
                                      Margin="0,5,0,15">
                                <ComboBoxItem Content="Branco" FontSize="18"/>
                                <ComboBoxItem Content="Preto" FontSize="18"/>
                                <ComboBoxItem Content="Pardo" FontSize="18"/>
                                <ComboBoxItem Content="Amarelo" FontSize="18"/>
                            </ComboBox>

                            <TextBlock Text="Telefone"
                                       FontSize="20"/>
                            <TextBox x:Name="txtTelefone"
                                     FontSize="18"
                                     Height="35"
                                     Margin="0,5,0,15" PreviewTextInput="DigitsOnly_PreviewTextInput"/>

                            <TextBlock Text="CEP"
                                       FontSize="20"/>
                            <TextBox x:Name="txtCEP" Height="35" Width="200" FontSize="18" Margin="0,5,0,15" PreviewTextInput="DigitsOnly_PreviewTextInput" LostFocus="TxtCEP_LostFocus" />

                            <TextBlock Text="Endereço"
                                       FontSize="20"/>
                            <TextBox x:Name="txtEndereco"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15" IsReadOnly="True" Background="#EEE"/>

                            <TextBlock Text="Número"
                                       FontSize="20"/>
                            <TextBox x:Name="txtNumero" Height="35" FontSize="18" Margin="0,5,0,15" PreviewTextInput="DigitsOnly_PreviewTextInput"/>

                            <TextBlock Text="Complemento"
                                       FontSize="20"/>
                            <TextBox x:Name="txtComplemento" Height="35" FontSize="18" Margin="0,5,0,15"/>

                            <Button Content="Salvar e Continuar"
                                    Height="45"
                                    FontSize="16"
                                    Background="#00BCD4"
                                    Foreground="White" Click="Button_Click"/>
                            <TextBlock x:Name="lblErrorPaciente" Foreground="Red" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                            <Button Content="Menu Principal"
       
        Height="45"
        Margin="0,15,0,0"
        FontSize="16"
        FontWeight="Bold"
        Background="#00838F"
        Foreground="White"
        
        Click="VoltarMenu_Click"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Viewbox>

    </Grid>

</Window>