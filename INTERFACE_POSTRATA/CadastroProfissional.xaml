<Window x:Class="INTERFACE_POSTRATA.CadastroProfissional"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro Profissional"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4FDFD">
        <StackPanel Margin="30">
            <TextBlock Text="Cadastro de Profissional" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="RM"/>
            <TextBox x:Name="txtRM" Height="30"/>
            <TextBlock Text="Nome" Margin="0,10,0,0"/>
            <TextBox x:Name="txtNome" Height="30"/>
            <TextBlock x:Name="lblCRM" Text="CRM" Margin="0,10,0,0"/>
            <TextBox x:Name="txtCRM" Height="30"/>
            <TextBlock Text="Senha" Margin="0,10,0,0"/>
            <PasswordBox x:Name="txtSenha" Height="30"/>
            <TextBlock Text="Cargo" Margin="0,10,0,0"/>
            <ComboBox x:Name="cbCargo" Height="30" SelectionChanged="CbCargo_SelectionChanged">
                <ComboBoxItem Content="RH" />
                <ComboBoxItem Content="MEDICO" />
                <ComboBoxItem Content="SECRETARIA" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Salvar" Width="120" Height="35" Click="Salvar_Click"/>
                <Button Content="Cancelar" Width="120" Height="35" Margin="10,0,0,0" Click="Cancelar_Click"/>
            </StackPanel>
            <TextBlock x:Name="lblStatus" Foreground="Red" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
