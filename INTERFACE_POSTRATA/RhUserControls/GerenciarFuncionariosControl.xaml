<UserControl x:Class="INTERFACE_POSTRATA.RhUserControls.GerenciarFuncionariosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho interno -->
        <Border Grid.Row="0" Background="{DynamicResource PoAccentBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
            <TextBlock Text="Gerenciar Contas" FontSize="22" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: busca + lista -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="txtSearch" Width="300" Height="34" FontSize="16" Margin="0,0,10,0"/>
                    <Button Content="Pesquisar" Style="{StaticResource PoButtonSecondary}" Width="120" Height="34" Click="Pesquisar_Click"/>
                    <Button Content="Limpar" Style="{StaticResource PoButtonMuted}" Width="100" Height="34" Margin="10,0,0,0" Click="LimparPesquisa_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" Margin="0,10,0,0"
                          SelectionMode="Single" SelectionChanged="DgUsers_SelectionChanged" Height="320">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RM"    Binding="{Binding RM}"    Width="80"/>
                        <DataGridTextColumn Header="Nome"  Binding="{Binding Nome}"  Width="*"/>
                        <DataGridTextColumn Header="CRM"   Binding="{Binding CRM}"   Width="150"/>
                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnExcluir" Content="Excluir"
                            Style="{StaticResource PoButtonDanger}"
                            Width="120" Height="36" IsEnabled="False"
                            Click="ExcluirUsuario_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Coluna direita: detalhes -->
            <Border Grid.Column="1" Style="{StaticResource PoSoftPanel}">
                <StackPanel>
                    <TextBlock Text="Detalhes do Usuário"
                               Style="{StaticResource PoSectionTitle}"
                               FontSize="20" Margin="0,0,0,10"/>

                    <TextBlock Text="RM" Style="{StaticResource PoFormLabel}"/>
                    <TextBox x:Name="txtRM" Height="32" IsEnabled="False"/>

                    <TextBlock Text="Nome" Style="{StaticResource PoFormLabel}" Margin="0,8,0,0"/>
                    <TextBox x:Name="txtNome" Height="32" IsEnabled="False"/>

                    <TextBlock x:Name="lblCRM" Text="CRM" Style="{StaticResource PoFormLabel}" Margin="0,8,0,0"/>
                    <TextBox x:Name="txtCRM" Height="32" IsEnabled="False"/>

                    <TextBlock Text="Cargo" Style="{StaticResource PoFormLabel}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="cbCargo" Height="32" IsEnabled="False" SelectionChanged="CbCargo_SelectionChanged">
                        <ComboBoxItem Content="RH"/>
                        <ComboBoxItem Content="MEDICO"/>
                        <ComboBoxItem Content="SECRETARIA"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="btnAlterarSenha" Content="Alterar Senha"
                                Style="{StaticResource PoButtonMuted}"
                                Width="140" Height="36" IsEnabled="False"
                                Click="AlterarSenha_Click"/>
                        <Button x:Name="btnSalvar" Content="Salvar"
                                Style="{StaticResource PoButtonSecondary}"
                                Width="120" Height="36" Margin="10,0,0,0" IsEnabled="False"
                                Click="SalvarUsuario_Click"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource PoButtonPrimary}"
                                Width="120" Height="36" Margin="10,0,0,0"
                                Click="CancelarEdicao_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="spChangePwd" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Nova Senha" Style="{StaticResource PoFormLabel}"/>
                        <PasswordBox x:Name="txtNewSenha" Height="32"/>
                        <TextBlock Text="Confirmar Nova Senha" Style="{StaticResource PoFormLabel}" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="txtConfirmSenha" Height="32"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Salvar Senha"
                                    Style="{StaticResource PoButtonSecondary}"
                                    Width="140" Height="36" Click="SalvarNovaSenha_Click"/>
                            <Button Content="Cancelar"
                                    Style="{StaticResource PoButtonPrimary}"
                                    Width="120" Height="36" Margin="10,0,0,0"
                                    Click="CancelarNovaSenha_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
