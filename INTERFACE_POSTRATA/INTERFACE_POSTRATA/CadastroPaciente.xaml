<Window x:Class="INTERFACE_POSTRATA.CadastroPaciente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro Paciente"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="#F4FDFD">

        <Viewbox Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080"
                  Background="#F4FDFD">

                <!-- TOPO -->

                <Border Background="#00BCD4"
                        Height="70"
                        VerticalAlignment="Top">

                    <Label Content="Cadastro de Paciente"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Border>

                <!-- FORM -->

                <Border Background="White"
                        Margin="30,100,30,30"
                        CornerRadius="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30">

                            <TextBlock Text="CPF"/>
                            <TextBox x:Name="txtCPF"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Nome"/>
                            <TextBox x:Name="txtNome"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Idade"/>
                            <TextBox x:Name="txtIdade"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Sexo"/>
                            <ComboBox x:Name="cbSexo"
                                      Height="35"
                                      Margin="0,5,0,15">

                                <ComboBoxItem Content="M"/>
                                <ComboBoxItem Content="F"/>

                            </ComboBox>

                            <TextBlock Text="Data Nascimento"/>
                            <DatePicker x:Name="dtNascimento"
                                        Height="35"
                                        Margin="0,5,0,15"/>

                            <TextBlock Text="Raça"/>
                            <TextBox x:Name="txtRaca"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Telefone"/>
                            <TextBox x:Name="txtTelefone"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Endereço"/>
                            <TextBox x:Name="txtEndereco"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Tipo Sanguíneo"/>
                            <ComboBox x:Name="cbSangue"
                                      Height="35"
                                      Margin="0,5,0,20">

                                <ComboBoxItem Content="A+"/>
                                <ComboBoxItem Content="A-"/>
                                <ComboBoxItem Content="B+"/>
                                <ComboBoxItem Content="B-"/>
                                <ComboBoxItem Content="AB+"/>
                                <ComboBoxItem Content="AB-"/>
                                <ComboBoxItem Content="O+"/>
                                <ComboBoxItem Content="O-"/>

                            </ComboBox>

                            <Button Content="Salvar e Continuar"
                                    Height="45"
                                    FontSize="16"
                                    Background="#00BCD4"
                                    Foreground="White"/>
                            <Button Content="Menu Principal"
       
        Height="45"
        Margin="0,15,0,0"
        FontSize="16"
        FontWeight="Bold"
        Background="#00838F"
        Foreground="White"
        
        Click="VoltarMenu_Click"/>
                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Viewbox>

    </Grid>

</Window>