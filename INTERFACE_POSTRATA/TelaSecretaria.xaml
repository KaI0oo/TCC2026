<Window x:Class="INTERFACE_POSTRATA.TelaSecretaria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tela Secretaria"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4FDFD">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Área Secretaria" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Bem-vindo ao painel da Secretaria." Margin="0,10,0,20" HorizontalAlignment="Center"/>
            <Button Content="Abrir Sistema" Width="180" Height="40" Click="OpenSystem_Click"/>
            <Button Content="Fechar" Width="180" Height="40" Margin="0,10,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
