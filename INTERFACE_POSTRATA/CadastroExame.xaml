<Window x:Class="INTERFACE_POSTRATA.CadastroExame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Cadastro Exame"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="{DynamicResource PoBackground}">

        <Viewbox Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080"
                  Background="{DynamicResource PoBackground}">

                <!-- TOPO -->
                <Border Background="{DynamicResource PoAccentBrush}"
                        Height="70"
                        VerticalAlignment="Top">
                    <Label Content="Cadastro de Exame de Sangue"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- FORMULÁRIO -->
                <Border Background="White"
                        Margin="30,100,30,30"
                        CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40">

                            <!-- CPF -->
                            <TextBlock Text="CPF do Paciente"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtCPF"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,15"
                                     LostFocus="TxtCPF_LostFocus"/>

                            <!-- RM -->
                            <TextBlock Text="RM do Médico"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtRM"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,15"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Background="#F5F5F5"/>

                            <!-- CRM -->
                            <TextBlock Text="CRM do Médico"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtCRMMedico"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,15"
                                     LostFocus="TxtCRMMedico_LostFocus"
                                     KeyDown="TxtCRMMedico_KeyDown"/>

                            <!-- NOME DO MÉDICO (preenchido automaticamente via CRM) -->
                            <TextBlock Text="Nome do Médico"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtNomeMedico"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,15"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Background="#F5F5F5"/>

                            <!-- IDADE -->
                            <TextBlock Text="Idade do Paciente"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtIdade"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,20"/>

                            <!-- PSA TOTAL / PSA LIVRE -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PSA Total"
                                               FontSize="20" FontWeight="SemiBold"/>
                                    <TextBox x:Name="txtPSATotal"
                                             Height="35" FontSize="18"
                                             Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PSA Livre"
                                               FontSize="20" FontWeight="SemiBold"/>
                                    <TextBox x:Name="txtPSALivre"
                                             Height="35" FontSize="18"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- DENSIDADE -->
                            <TextBlock Text="Densidade PSA"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtDensidade"
                                     Height="35" FontSize="18"
                                     Margin="0,5,0,20"/>

                            <!-- DATA -->
                            <TextBlock Text="Data do Exame"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <DatePicker x:Name="dtExame"
                                        Height="35" FontSize="20"
                                        Margin="0,5,0,25"/>

                            <!-- BOTÕES INFERIORES -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button x:Name="btnMenuPrincipal"
                                        Content="Menu Principal"
                                        Click="VoltarMenu_Click"
                                        Width="200" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#00838F" Foreground="White"/>
                                <Button x:Name="btnGerarLaudo"
                                        Content="Gerar Laudo"
                                        Click="GerarLaudo_Click"
                                        Width="200" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#00BCD4" Foreground="White"
                                        Margin="20,0,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
