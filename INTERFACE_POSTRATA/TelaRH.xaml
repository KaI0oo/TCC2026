<Window x:Class="INTERFACE_POSTRATA.TelaRH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tela RH" Height="400" Width="600">
    <Grid Background="#F4FDFD">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Área RH" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Bem-vindo ao painel de Recursos Humanos." Margin="0,10,0,20" HorizontalAlignment="Center"/>
            <Button Content="Cadastro de Profissionais" Width="220" Height="40" Click="CadastroProfissionais_Click"/>
            <Button Content="Alterar Administrador" Width="220" Height="40" Margin="0,10,0,0" Click="AlterarAdministrador_Click"/>
            <Button Content="Conta" Width="220" Height="40" Margin="0,10,0,0" Click="Conta_Click"/>
            <Button Content="Fechar" Width="220" Height="40" Margin="0,20,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
