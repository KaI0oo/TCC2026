<Window x:Class="INTERFACE_POSTRATA.TelaRH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RH"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource PoWindow}">

    <Grid>
        <Border Style="{StaticResource PoPanel}"
                MaxWidth="520"
                MinWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20"
                Padding="40">

            <StackPanel HorizontalAlignment="Center">

                <Label Content="Área RH"
                       Style="{StaticResource PoTitleText}"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Bem-vindo ao painel de Recursos Humanos."
                           FontSize="18"
                           Foreground="Gray"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>

                <Button x:Name="btnAbrirSistema"
                        Content="Abrir Sistema"
                        Style="{StaticResource PoButtonPrimary}"
                        Width="240"
                        Margin="0,0,0,12"
                        Click="AbrirSistema_Click"/>

                <Button x:Name="btnLogout"
                        Content="Logout"
                        Style="{StaticResource PoButtonSecondary}"
                        Width="240"
                        Margin="0,0,0,12"
                        Click="Logout_Click"/>

                <Button x:Name="btnFechar"
                        Content="Fechar"
                        Style="{StaticResource PoButtonDanger}"
                        Width="240"
                        Click="Fechar_Click"/>

            </StackPanel>
        </Border>
    </Grid>

</Window>
