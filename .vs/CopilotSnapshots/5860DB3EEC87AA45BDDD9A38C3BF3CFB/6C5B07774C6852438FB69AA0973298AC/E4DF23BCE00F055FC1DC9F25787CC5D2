<Window x:Class="INTERFACE_POSTRATA.CadastroPaciente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro Paciente"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="#F4FDFD">

        <Viewbox Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080"
                  Background="#F4FDFD">

                <!-- TOPO -->

                <Border Background="#00BCD4"
                        Height="70"
                        VerticalAlignment="Top">

                    <Label Content="Cadastro de Paciente"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Border>

                <!-- FORM -->

                <Border Background="White"
                        Margin="30,100,30,30"
                        CornerRadius="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30"
                                    
                                    >


                            <TextBlock Text="CPF"
                                       FontSize="20"
                                       />
                            
                            <TextBox x:Name="txtCPF"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Nome"
                                       FontSize="20"
                                       />
                            <TextBox x:Name="txtNome"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Idade"
                                       FontSize="20"/>
                            <TextBox x:Name="txtIdade"
                                     Height="35"
                                        FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Sexo"
                                       FontSize="20"/>
                            <ComboBox x:Name="cbSexo"
                                      Height="35"
                                      FontSize="18"
                                      Margin="0,5,0,15">

                                <ComboBoxItem Content="M"
                                              FontSize="18"/>
                                <ComboBoxItem Content="F"
                                              FontSize="18"/>

                            </ComboBox>

                            <TextBlock Text="Data Nascimento"
                                       FontSize="20"/>
                            <DatePicker x:Name="dtNascimento"
                                        Height="35"
                                        FontSize="18"
                                        Margin="0,5,0,15"/>

                            <TextBlock Text="Raça"
                                       FontSize="20"/>
                            <TextBox x:Name="txtRaca"
                                     FontSize="18"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Telefone"
                                       FontSize="20"/>
                            <TextBox x:Name="txtTelefone"
                                     FontSize="18"
                                     Height="35"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Endereço"
                                       FontSize="20"/>
                            <TextBox x:Name="txtEndereco"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Tipo Sanguíneo"
                                       FontSize="20"/>
                            <ComboBox x:Name="cbSangue"
                                      Height="35"
                                      FontSize="18"
                                      Margin="0,5,0,20">

                                <ComboBoxItem Content="A+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="A-"
                                              FontSize="18"/>
                                <ComboBoxItem Content="B+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="B-"
                                              FontSize="18"/>
                                <ComboBoxItem Content="AB+"
                                              FontSize="18"/>
                                <ComboBoxItem Content="AB-"/>
                                <ComboBoxItem Content="O+"/>
                                <ComboBoxItem Content="O-"/>

                            </ComboBox>

                            <Button Content="Salvar e Continuar"
                                    Height="45"
                                    FontSize="16"
                                    Background="#00BCD4"
                                    Foreground="White" Click="Button_Click"/>
                            <TextBlock x:Name="lblErrorPaciente" Foreground="Red" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                            <Button Content="Menu Principal"
       
        Height="45"
        Margin="0,15,0,0"
        FontSize="16"
        FontWeight="Bold"
        Background="#00838F"
        Foreground="White"
        
        Click="VoltarMenu_Click"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Viewbox>

    </Grid>

</Window>