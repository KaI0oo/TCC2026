<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Laudo Médico</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="laudo-container">
    <header class="laudo-header">
      <div class="logo">LOGOTIPO</div>
      <div class="clinic-info">
        <h1>Clínica / Serviço Médico</h1>
        <p>Endereço • Telefone • Email</p>
      </div>
    </header>

    <section class="patient-info">
      <h2>Dados do Paciente</h2>
      <div class="row"><span class="label">Paciente:</span> <span class="value">{{PACIENTE}}</span></div>
      <div class="row"><span class="label">Idade:</span> <span class="value">{{IDADE}}</span></div>
      <div class="row"><span class="label">Médico:</span> <span class="value">{{MEDICO}} ({{CRM}})</span></div>
    </section>

    <section class="results">
      <h2>Resultados</h2>
      <table class="results-table">
        <thead>
          <tr><th>Exame</th><th>Resultado</th></tr>
        </thead>
        <tbody>
          <tr><td>PSA Total</td><td>{{PSATOTAL}}</td></tr>
          <tr><td>PSA Livre</td><td>{{PSALIVRE}}</td></tr>
          <tr><td>PSA Densidade</td><td>{{PSADENSIDADE}}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="conclusion">
      <h2>Conclusão</h2>
      <div class="conclusion-box">
        <p>Resultado: <strong>{{RESULTADO}}</strong></p>
        <p>Observações: _________________________________________________</p>
        <p>________________________________________________________________</p>
      </div>
    </section>

    <footer class="laudo-footer">
      <div class="signature">
        <p>Assinatura do Médico</p>
        <div class="sig-line"></div>
        <p>{{MEDICO}} - {{CRM}}</p>
      </div>
      <div class="print-area">
        <button onclick="window.print()">Imprimir</button>
      </div>
    </footer>
  </div>
</body>
</html>
