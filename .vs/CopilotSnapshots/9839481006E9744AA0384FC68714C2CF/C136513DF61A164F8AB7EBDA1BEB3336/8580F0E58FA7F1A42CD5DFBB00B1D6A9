{
	Path.Combine(dirExecavel, "..", "..", "..", "IA", "executar_ia.py"),
	Path.Combine(dirExecavel, "..", "..", "IA", "executar_ia.py"),
	Path.Combine(dirExecavel, "..", "IA", "executar_ia.py"),
	Path.Combine(dirExecavel, "IA", "executar_ia.py"),
	Path.Combine(dirExecavel, "executar_ia.py")
};

foreach (var caminho in caminhosPossiveis)
{
	string caminhoCompleto = Path.GetFullPath(caminho);
	if (File.Exists(caminhoCompleto))
	{
		caminhoScriptIA = caminhoCompleto;
		break;
	}
}


