import pickle
import pandas as pd
import sys
import os
import warnings

# Suprimir warnings de scikit-learn sobre versão
warnings.filterwarnings('ignore', category=UserWarning)

# Carregar o modelo
pasta_atual = os.path.dirname(os.path.abspath(__file__))
caminho_modelo = os.path.join(pasta_atual, "IA.pkl")

try:
    with open(caminho_modelo, "rb") as arquivo:
        modelo = pickle.load(arquivo)
except Exception as e:
    print(f"Erro ao carregar modelo: {e}")
    sys.exit(1)

# Receber argumentos
idade = float(sys.argv[1])
psa_total = float(sys.argv[2])
psa_livre = float(sys.argv[3])
densidade = float(sys.argv[4])

# Debug: Exibir valores recebidos
import sys as sys_debug
print(f"DEBUG - Idade: {idade}, PSA Total: {psa_total}, PSA Livre: {psa_livre}, Densidade: {densidade}", file=sys_debug.stderr)

# Calcular relação L/T
relacao_lt = psa_livre / psa_total

# Debug: Exibir relação calculada
print(f"DEBUG - Relação L/T: {relacao_lt} ({relacao_lt*100:.2f}%)", file=sys_debug.stderr)

# Criar entrada para o modelo
entrada = pd.DataFrame(
    [[psa_total, psa_livre, relacao_lt, idade, densidade]],
    columns=[
        "PSA_Total",
        "PSA_Livre",
        "PSA_Relacao_L/T",
        "Idade",
        "PSA_Densidade"
    ]
)

# Fazer predição
resultado = modelo.predict(entrada)[0]

# Retornar resultado
if resultado == 1:
    print("SUSPEITO")
else:
    print("BENIGNO")
