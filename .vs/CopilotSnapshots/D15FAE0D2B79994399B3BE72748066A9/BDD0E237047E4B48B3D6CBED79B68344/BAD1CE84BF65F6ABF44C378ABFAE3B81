using System;
using System.IO;
using System.Text.RegularExpressions;
using System.Linq;
// NOTE: This class prefers to use UglyToad.PdfPig for reliable PDF text extraction.
// Please install the NuGet package UglyToad.PdfPig if you want best results:
// PM> Install-Package UglyToad.PdfPig
// If the package is not available, a lightweight fallback extractor will be used.

namespace INTERFACE_POSTRATA
{
    public static class PdfExtractor
    {
        // Implementação fallback: tenta extrair texto bruto do PDF lendo como texto
        // Não garante alta fidelidade, mas evita dependência externa.
        public static string ExtrairPSA(string caminhoPdf)
        {
            try
            {
                string texto = null;
                try
                {
                    // Tentar abrir como texto puro (falls back se PDF binário)
                    texto = File.ReadAllText(caminhoPdf);
                }
                catch { }

                // Se não obteve texto, tentar heurística simples: ler bytes e substituir control chars
                if (string.IsNullOrEmpty(texto))
                {
                    try
                    {
                        var bytes = File.ReadAllBytes(caminhoPdf);
                        // Extrair sequências ASCII plausíveis
                        var sb = new System.Text.StringBuilder();
                        foreach (var b in bytes)
                        {
                            if (b >= 32 && b <= 126) sb.Append((char)b);
                            else sb.Append(' ');
                        }
                        texto = sb.ToString();
                    }
                    catch { }
                }

                if (string.IsNullOrEmpty(texto)) return null;

                // Padrões para PSA
                var patterns = new[]
                {
                    new Regex(@"PSA\s*(?:Total)?\s*[:\-]?\s*([0-9]+(?:[.,][0-9]+)?)", RegexOptions.IgnoreCase),
                    new Regex(@"PSA Total\s*[:\-]?\s*([0-9]+(?:[.,][0-9]+)?)", RegexOptions.IgnoreCase),
                    new Regex(@"PSA Livre\s*[:\-]?\s*([0-9]+(?:[.,][0-9]+)?)", RegexOptions.IgnoreCase),
                };

                foreach (var pat in patterns)
                {
                    var m = pat.Match(texto);
                    if (m.Success) return m.Groups[1].Value.Replace(',', '.');
                }

                var m2 = Regex.Match(texto, "PSA[\\s\\S]{0,30}([0-9]+(?:[.,][0-9]+)?)", RegexOptions.IgnoreCase);
                if (m2.Success) return m2.Groups[1].Value.Replace(',', '.');

                return null;
            }
            catch
            {
                return null;
            }
        }
    }
}
