<Window x:Class="INTERFACE_POSTRATA.CadastroExame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INTERFACE_POSTRATA"
        mc:Ignorable="d"
        Title="Cadastro Exame"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Background="#F4FDFD">

        <Viewbox Stretch="Uniform">

            <Grid Width="1920"
                  Height="1080"
                  Background="#F4FDFD">

                <!-- TOPO -->

                <Border Background="#00BCD4"
                        Height="70"
                        VerticalAlignment="Top">

                    <Label Content="Cadastro de Exame de Sangue"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Border>

                <!-- FORMULÁRIO -->

                <Border Background="White"
                        Margin="30,100,30,30"
                        CornerRadius="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="40">

                            <!-- CPF -->

                            <TextBlock Text="CPF do Paciente"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtCPF"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <!-- RM -->

                            <TextBlock Text="RM do Médico"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtRM"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,15"/>

                            <!-- IDADE -->

                            <TextBlock Text="Idade do Paciente"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtIdade"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,20"/>

                            <!-- PSA TOTAL / PSA LIVRE -->

                            <Grid Margin="0,0,0,20">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="PSA Total"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="txtPSATotal"
                                             Height="35"
                                             FontSize="18"
                                             Margin="0,5,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="PSA Livre"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="txtPSALivre"
                                             Height="35"
                                             FontSize="18"
                                             Margin="0,5,0,0"/>

                                </StackPanel>

                            </Grid>

                            <!-- DENSIDADE -->

                            <TextBlock Text="Densidade PSA"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtDensidade"
                                     Height="35"
                                     FontSize="18"
                                     Margin="0,5,0,20"/>

                            <!-- PDF -->

                            <Border Background="#E0F7FA"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,10,0,20">

                                <StackPanel>

                                    <TextBlock Text="Importar Exame PDF"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#00838F"
                                               Margin="0,0,0,15"/>

                                    <Button Content="Selecionar PDF"
                                            x:Name="btnSelecionarPDF"
                                            Click="SelecionarPDF_Click"
                                            Height="40"
                                            Width="180"
                                            Background="#00BCD4"
                                            Foreground="White"
                                            FontWeight="Bold"/>

                                    <TextBlock x:Name="txtPDFSelecionado"
                                               Text="Nenhum PDF selecionado"
                                               Margin="0,15,0,0"
                                               Foreground="Gray"
                                               FontSize="20"/>

                                    <Border Background="White"
                                            Margin="0,20,0,0"
                                            Padding="15"
                                            CornerRadius="8">

                                        <StackPanel>

                                            <TextBlock Text="Leitura Automática"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#00838F"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="PSA encontrado: " FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock x:Name="txtPSAEncontrado" Text="--" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Button x:Name="btnConfirmarPSA" Content="Confirmar PSA" Width="120" Height="28" Margin="12,0,0,0" IsEnabled="False" Click="ConfirmarPSA_Click" />
                                            </StackPanel>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                            <!-- DATA -->

                            <TextBlock Text="Data do Exame"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <DatePicker x:Name="dtExame"
                                        Height="35"
                                        FontSize="20"
                                        Margin="0,5,0,25"/>

                            <!-- BOTÃO -->

                            <Button Content="Gerar Laudo"
                                    Click="GerarLaudo_Click"
                                    Height="50"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Background="#00BCD4"
                                    Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Content="Menu Principal" Height="45" Width="160" FontSize="16" FontWeight="Bold" Background="#00838F" Foreground="White" Click="VoltarMenu_Click" />
                                <Button Content="Limpar Campos" Height="45" Width="160" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" Background="#FFC107" Foreground="Black" Click="LimparCampos_Click" />
                            </StackPanel>
                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Viewbox>

    </Grid>

</Window>